{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "enabled": true,
    // Keep PR bodies to the dep table + notes + rebase checkbox; the default
    // includes full changelogs, which blew past GitHub's body size limit on
    // grouped PRs (API 500s on creation).
    "prBodyTemplate": "{{{table}}}{{{notes}}}{{{controls}}}",
    "prConcurrentLimit": 12,
    "prHourlyLimit": 0,
    "semanticCommits": "enabled",
    "dependencyDashboard": true,
    "dependencyDashboardTitle": "Renovate Dashboard",
    "suppressNotifications": [
        "prIgnoreNotification"
    ],
    "rebaseWhen": "conflicted",
    "ignoreDeps": [
        "ghcr.io/fluxcd/helm-controller",
        "ghcr.io/fluxcd/image-automation-controller",
        "ghcr.io/fluxcd/image-reflector-controller",
        "ghcr.io/fluxcd/kustomize-controller",
        "ghcr.io/fluxcd/notification-controller",
        "ghcr.io/fluxcd/source-controller"
    ],
    "pre-commit": {
        "enabled": true
    },
    "customManagers": [
        {
            "customType": "regex",
            "fileMatch": [
                "infra/containers/.+/.+\\.MODULE\\.bazel$",
                "MODULE.bazel"
            ],
            "matchStrings": [
                "# renovate: datasource\\s*\\=\\s*(?<datasource>(\\w)+) depName=(?<depName>[^\\s]+)\\s+\\S+_VERSION\\s*=\\s*\"(?<currentValue>[^\"]+)\""
            ],
            "datasourceTemplate": "{{datasource}}",
            "depNameTemplate": "{{depName}}",
            "versioningTemplate": "loose"
        },
        {
            "customType": "regex",
            "fileMatch": [
                "(^|/)go\\.MODULE\\.bazel$"
            ],
            "matchStrings": [
                "go_sdk\\.download\\([^)]*?version\\s*=\\s*\"(?<currentValue>[^\"]+)\""
            ],
            "depNameTemplate": "go",
            "datasourceTemplate": "golang-version"
        }
    ],
    "packageRules": [
        {
            "matchDatasources": [
                "helm"
            ],
            "separateMinorPatch": true,
            "ignoreDeprecated": true
        },
        {
            "matchDatasources": [
                "docker"
            ],
            "enabled": true,
            "commitMessageTopic": "container image {{depName}}",
            "commitMessageExtra": "to {{#if isSingleVersion}}v{{{newVersion}}}{{else}}{{{newValue}}}{{/if}}",
            "matchUpdateTypes": [
                "major",
                "minor",
                "patch"
            ]
        },
        {
            "matchDatasources": [
                "docker"
            ],
            "matchUpdateTypes": [
                "major"
            ],
            "labels": [
                "renovate/image",
                "dep/major"
            ]
        },
        {
            "matchDatasources": [
                "docker"
            ],
            "matchUpdateTypes": [
                "minor"
            ],
            "labels": [
                "renovate/image",
                "dep/minor"
            ]
        },
        {
            "matchDatasources": [
                "docker"
            ],
            "matchUpdateTypes": [
                "patch"
            ],
            "labels": [
                "renovate/image",
                "dep/patch"
            ]
        },
        {
            "matchDatasources": [
                "docker"
            ],
            "matchUpdateTypes": [
                "digest"
            ],
            "labels": [
                "renovate/image",
                "dep/digest"
            ]
        },
        {
            "matchFileNames": [
                "infra/containers/**"
            ],
            "matchDatasources": [
                "docker"
            ],
            "groupName": "infra containers"
        },
        {
            "matchDatasources": [
                "maven"
            ],
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "groupName": "java dependencies"
        },
        {
            "matchDatasources": [
                "maven"
            ],
            "matchPackageNames": [
                "org.flywaydb:**"
            ],
            "groupName": "flyway"
        },
        {
            "matchFileNames": [
                "projects/wedding/**"
            ],
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "groupName": "wedding project dependencies"
        },
        {
            "matchDatasources": [
                "helm"
            ],
            "matchUpdateTypes": [
                "major"
            ],
            "labels": [
                "renovate/helm",
                "dep/major"
            ]
        },
        {
            "matchDatasources": [
                "helm"
            ],
            "matchUpdateTypes": [
                "minor"
            ],
            "labels": [
                "renovate/helm",
                "dep/minor"
            ]
        },
        {
            "matchDatasources": [
                "helm"
            ],
            "matchUpdateTypes": [
                "patch"
            ],
            "labels": [
                "renovate/helm",
                "dep/patch"
            ]
        },
        {
            "matchManagers": [
                "bazel-module"
            ],
            "matchDatasources": [
                "bazel"
            ],
            "matchUpdateTypes": [
                "major"
            ],
            "labels": [
                "renovate/bazel_dep",
                "dep/major"
            ]
        },
        {
            "matchManagers": [
                "bazel-module"
            ],
            "matchDatasources": [
                "bazel"
            ],
            "matchUpdateTypes": [
                "minor"
            ],
            "labels": [
                "renovate/bazel_dep",
                "dep/minor"
            ]
        },
        {
            "matchManagers": [
                "bazel-module"
            ],
            "matchDatasources": [
                "bazel"
            ],
            "matchUpdateTypes": [
                "patch"
            ],
            "labels": [
                "renovate/bazel_dep",
                "dep/patch"
            ]
        },
        {
            "matchManagers": [
                "bazel-module"
            ],
            "matchDatasources": [
                "bazel"
            ],
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "groupName": "bazel dependencies"
        },
        {
            "matchManagers": [
                "custom.regex"
            ],
            "matchDatasources": [
                "golang-version"
            ],
            "matchDepNames": [
                "go"
            ],
            "groupName": "bazel dependencies",
            "postUpgradeTasks": {
                "commands": [
                    "bazel mod deps --lockfile_mode=update"
                ],
                "fileFilters": [
                    "MODULE.bazel.lock"
                ],
                "executionMode": "update"
            }
        },
        {
            "matchManagers": [
                "bazel-module"
            ],
            "postUpgradeTasks": {
                "commands": [
                    "bazel mod deps --lockfile_mode=update"
                ],
                "fileFilters": [
                    "MODULE.bazel.lock"
                ],
                "executionMode": "update"
            }
        },
        {
            // Last rule wins: every non-breaking update across all managers
            // lands in one PR. Majors stay as individual PRs.
            "matchUpdateTypes": [
                "minor",
                "patch",
                "digest",
                "pin",
                "pinDigest"
            ],
            // Grouped PRs always use groupName as the commit topic, so the
            // fun title lives here; groupSlug keeps the branch name stable.
            "groupName": "the world 🫪",
            "groupSlug": "all-non-major",
            "commitMessageAction": "bump",
            "commitMessageExtra": ""
        },
        {
            "matchManagers": [
                "gomod"
            ],
            "postUpgradeTasks": {
                "commands": [
                    "bazel run @rules_go//go -- mod tidy"
                ],
                "fileFilters": [
                    "go.mod",
                    "go.sum"
                ],
                "executionMode": "update"
            }
        }
    ]
}
